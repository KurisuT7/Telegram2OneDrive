# Create this token with @BotFather. Never commit the real value.
TELEGRAM_BOT_TOKEN=

# Leave empty for the first start, send /whoami to the bot, then add your numeric user ID.
# Separate multiple IDs with commas.
TELEGRAM_ALLOWED_USER_IDS=

# Group and supergroup uploads are rejected by default even for an allowed user.
TELEGRAM_ALLOW_GROUP_CHATS=false

# The official cloud Bot API can download files up to 20 MiB.
MAX_FILE_MIB=20

# Optional Local Bot API Server integration. See docs/local-bot-api.md.
TELEGRAM_LOCAL_MODE=false
TELEGRAM_BASE_URL=
TELEGRAM_BASE_FILE_URL=

# Name of the OneDrive remote created by `rclone config`.
RCLONE_REMOTE=onedrive

# Optional absolute path. Leave empty to use rclone's normal config discovery.
RCLONE_CONFIG=

# Destination below the OneDrive root. Files are placed in category subdirectories.
ONEDRIVE_BASE_PATH=Telegram2OneDrive

# rename: add " (n)"; replace: overwrite; fail: reject an existing name.
DUPLICATE_POLICY=rename

# Maximum time for one rclone command.
RCLONE_TIMEOUT_SECONDS=3600

# Optional directory for cloud Bot API downloads. Leave empty for the system temp directory.
TRANSFER_TMP_DIR=
