# Copy this file to .env in the deployment directory. The program loads it automatically.
# Create this token with @BotFather. Do not commit the completed .env file.
TELEGRAM_BOT_TOKEN=

# Leave empty for the first start, send /whoami to the bot, then add your numeric user ID.
# Separate multiple IDs with commas.
TELEGRAM_ALLOWED_USER_IDS=

# Group and supergroup uploads are rejected by default even for an allowed user.
TELEGRAM_ALLOW_GROUP_CHATS=false

# Optional. When empty, the limit is 20 MiB normally or 2048 MiB with MTProto enabled.
MAX_FILE_MIB=

# Optional Local Bot API Server integration. See docs/local-bot-api.md.
TELEGRAM_LOCAL_MODE=false
TELEGRAM_BASE_URL=
TELEGRAM_BASE_FILE_URL=

# Optional large-file fallback. Enable it only when files may be larger than 20 MiB.
# The container image includes MTProto support. Native installs also need the `mtproto` extra.
# Create an application at https://my.telegram.org/apps.
TELEGRAM_MTPROTO_ENABLED=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Advanced overrides. Normally leave the directory empty and keep the default name.
# The default directory is ~/.local/state/telegram2onedrive/mtproto on Linux.
TELEGRAM_MTPROTO_SESSION_DIR=
TELEGRAM_MTPROTO_SESSION_NAME=telegram2onedrive

# Name of the OneDrive remote created by `rclone config`.
RCLONE_REMOTE=onedrive

# Optional absolute path. Leave empty for native discovery; Compose supplies its volume path.
RCLONE_CONFIG=

# Destination below the OneDrive root. Files are placed in category subdirectories.
ONEDRIVE_BASE_PATH=Telegram2OneDrive

# rename: add " (n)"; replace: overwrite; fail: reject an existing name.
DUPLICATE_POLICY=rename

# Maximum time for one rclone command.
RCLONE_TIMEOUT_SECONDS=3600

# Optional directory for cloud Bot API and MTProto downloads. Leave empty for the system temp.
TRANSFER_TMP_DIR=
